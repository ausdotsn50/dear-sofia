---
// Below 1024px: a fixed bar with the note summary, and a bottom sheet that
// holds the order note. order-note-ui.ts moves the note in and out.
---

<div class="order-bar surface-slate js-only" data-order-bar hidden>
  <p class="order-bar__summary" data-bar-summary></p>
  <button type="button" class="btn btn--amber order-bar__review" aria-haspopup="dialog" data-review>
    Review note
  </button>
</div>

<dialog class="sheet surface-slate" aria-labelledby="sheet-title" data-sheet>
  <div class="sheet__head">
    <h2 class="sheet__title" id="sheet-title">Your note</h2>
    <button type="button" class="sheet__close" data-close>Close</button>
  </div>
  <div data-sheet-slot></div>
</dialog>

<p class="visually-hidden js-only" aria-live="polite" data-announce></p>

<style>
  .order-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    min-height: calc(64px + env(safe-area-inset-bottom));
    padding: 0.5rem max(16px, var(--gutter) - 16px) calc(0.5rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--chalk-soft);
    box-shadow: var(--shadow-bar);
  }

  .order-bar__summary {
    font-size: 1rem;
    font-weight: 600;
    font-variation-settings: 'opsz' 16;
    line-height: 1.3;
  }

  .order-bar__summary :global(.order-bar__detail) {
    white-space: nowrap;
  }

  .order-bar__review {
    flex: none;
    min-height: 44px;
    padding-inline: 1rem;
  }

  :global(body.has-order-bar) {
    padding-bottom: calc(64px + env(safe-area-inset-bottom));
  }

  @media (min-width: 1024px) {
    .order-bar {
      display: none !important;
    }

    :global(body.has-order-bar) {
      padding-bottom: 0;
    }
  }

  .sheet {
    inset: auto 0 0 0;
    width: 100%;
    max-width: 40rem;
    max-height: min(92dvh, 100% - 1.5rem);
    margin: auto auto 0;
    padding: 0 var(--space-s) calc(var(--space-s) + env(safe-area-inset-bottom));
    border: 0;
    border-radius: var(--radius-note) var(--radius-note) 0 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .sheet::backdrop {
    background: var(--scrim);
  }

  :global(html:has(.sheet[open])) {
    overflow: hidden;
  }

  .sheet__head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-2xs);
    background: var(--slate);
  }

  .sheet__title {
    font-size: var(--text-h3);
    font-weight: 700;
    font-variation-settings: 'opsz' 24;
    letter-spacing: -0.01em;
  }

  .sheet__close {
    min-height: 44px;
    padding: 0 0.25rem;
    border: 0;
    background: transparent;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
