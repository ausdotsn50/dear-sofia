---
// The order note, built as a live version of the café's cup label (SPEC §7).
// One instance per page: order-note-ui.ts moves it between the menu board
// (≥1024px) and the bottom sheet in OrderBar (<1024px).
import Seal from './Seal.astro';
import { site } from '../data/site';
import { formatPeso } from '../lib/format';
import { menu } from '../lib/menu';

interface Props {
  level?: number;
}

const { level = 3 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
const canSend = site.messenger.page !== null;
const orderTypes = [
  { value: 'for-here', label: 'for here' },
  { value: 'to-go', label: 'to-go' },
  { value: 'delivery', label: 'delivery' },
];
---

<div class="note surface-label" id="order-note" data-note data-page={site.messenger.page ?? ''}>
  <div class="note__seal">
    <Seal size={64} />
  </div>

  <div class="note__body">
    <Heading class="visually-hidden" id="note-title">Your order note</Heading>

    <div class="note__for">
      <label class="hand note__for-label" for="note-name">this good cuppa is for our friend</label>
      <input
        class="hand note__name"
        id="note-name"
        type="text"
        autocomplete="name"
        maxlength="80"
        spellcheck="false"
        data-field="name"
      />
    </div>

    <p class="note__empty" tabindex="-1" data-empty>Your note is empty. Add a drink from the menu to start.</p>
    <ul class="note__lines" role="list" data-lines></ul>

    <fieldset class="note__type">
      <legend class="visually-hidden">Order type</legend>
      {
        orderTypes.map((type) => (
          <label class="box">
            <span class="box__mark">
              <input type="radio" name="order-type" value={type.value} data-field="orderType" />
              <svg class="box__check" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4.2 12.8c1.7 1.1 3.1 2.8 4.3 5 2.2-5.3 5.9-9.7 11.2-13.1" />
              </svg>
            </span>
            {type.label}
          </label>
        ))
      }
    </fieldset>

    <div class="note__field" data-address-field hidden>
      <label for="note-address">Delivery address</label>
      <textarea id="note-address" rows="2" maxlength="300" autocomplete="street-address" data-field="address"
      ></textarea>
    </div>
    <div class="note__field">
      <label for="note-time" data-time-label>Pickup time</label>
      <input id="note-time" class="note__time" type="time" data-field="time" />
    </div>
    <div class="note__field">
      <label for="note-notes">Notes</label>
      <input id="note-notes" type="text" maxlength="300" data-field="notes" />
    </div>

    <p class="note__total" data-total hidden></p>

    <div class="note__actions">
      {
        canSend && (
          <a class="btn btn--brick note__send" target="_blank" rel="noopener" aria-describedby="note-reason" data-send>
            Send note on Messenger<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        )
      }
      <button
        type="button"
        class:list={['note__copy', canSend ? 'note__copy--link' : 'btn btn--brick']}
        aria-describedby="note-reason"
        data-copy
      >
        {canSend ? 'Copy note instead' : 'Copy note'}
      </button>
      <p class="note__small" id="note-reason" data-reason>Add at least one drink first.</p>
      <p class="note__small" data-long hidden>Long note. If Messenger cuts it off, paste the copied note instead.</p>
      <p class="note__small note__status" role="status" data-copy-status></p>
      <textarea class="note__fallback" readonly rows="8" aria-label="Your note as text" data-fallback hidden></textarea>
    </div>
  </div>

  <template data-line-template>
    <li class="line">
      <div class="line__top">
        <p class="line__desc">
          <span data-qty></span> × <span data-name></span>,
          <button type="button" class="line__temp" data-action="temp"><span data-temp></span></button>
        </p>
        <span class="line__price price" data-price></span>
      </div>
      <p class="line__extras-summary" data-extras-summary></p>
      <div class="line__controls">
        <button type="button" class="line__btn" data-action="dec">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10"></path></svg>
        </button>
        <button type="button" class="line__btn" data-action="inc">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10"></path></svg>
        </button>
        <button type="button" class="line__btn" data-action="remove">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"></path></svg>
        </button>
        <button type="button" class="line__extras-toggle" aria-expanded="false" data-action="extras">
          Extras<span class="visually-hidden" data-extras-for></span>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4"></path></svg>
        </button>
      </div>
      <div class="line__extras" data-extras-panel hidden>
        {
          menu.extras.map((extra) => (
            <label class="box box--small">
              <span class="box__mark">
                <input type="checkbox" value={extra.id} data-action="extra" />
                <svg class="box__check" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4.2 12.8c1.7 1.1 3.1 2.8 4.3 5 2.2-5.3 5.9-9.7 11.2-13.1" />
                </svg>
              </span>
              {extra.name}
              {extra.price !== null && <span class="price">+{formatPeso(extra.price)}</span>}
            </label>
          ))
        }
      </div>
    </li>
  </template>
</div>

<script>
  import { initOrderNote } from '../lib/order-note-ui';
  initOrderNote();
</script>

<style>
  .note {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    border-radius: var(--radius-note);
    box-shadow: var(--shadow-note);
    padding: var(--space-s) var(--space-s) var(--space-m) var(--space-xs);
    font-size: 1rem;
    line-height: 1.45;
  }

  .note__seal {
    padding-right: var(--space-xs);
    border-right: 1px solid var(--ink);
  }

  @media (max-width: 479px) {
    .note__seal :global(.seal) {
      width: 48px;
      height: 48px;
    }
  }

  .note__body {
    display: grid;
    align-content: start;
    gap: var(--space-s);
    min-width: 0;
    padding-left: var(--space-s);
  }

  /* Cup-label line and the name "written" under it */
  .note__for {
    display: grid;
    gap: 0.125rem;
  }

  .note__for-label {
    font-size: 22px;
  }

  .note__name {
    width: 100%;
    padding: 0.125rem 0;
    border: 0;
    border-bottom: 1.5px solid var(--ink);
    border-radius: 0;
    background: transparent;
    font-size: 26px;
    line-height: 1.3;
  }

  .note__empty {
    color: var(--ink-soft);
  }

  .note__empty:focus {
    outline: none;
  }

  .note__lines:empty {
    display: none;
  }

  /* One line per drink */
  .line {
    display: grid;
    gap: 0.375rem;
    padding-block: 0.625rem;
  }

  .line + .line {
    border-top: 1px dashed var(--ink-soft);
  }

  .line--enter {
    animation: line-in 160ms var(--ease-out);
  }

  @keyframes line-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .line__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs);
  }

  .line__desc {
    font-weight: 600;
    font-variation-settings: 'opsz' 16;
  }

  .line__price {
    font-weight: 600;
  }

  .line__temp {
    display: inline-flex;
    margin-left: 0.2em;
    align-items: center;
    min-height: 32px;
    padding: 0 0.625rem;
    border: 1.5px solid var(--ink-soft);
    border-radius: var(--radius-pill);
    background: transparent;
    font-weight: 600;
    line-height: 1;
    vertical-align: baseline;
  }

  .line__temp:hover {
    border-color: var(--ink);
  }

  .line__extras-summary {
    color: var(--ink-soft);
    font-size: var(--text-small);
  }

  .line__extras-summary:empty {
    display: none;
  }

  .line__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
  }

  .line__btn {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1.5px solid var(--ink-soft);
    border-radius: var(--radius-control);
    background: transparent;
  }

  .line__btn:hover {
    border-color: var(--ink);
  }

  .line__btn[aria-disabled='true'] {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .line__btn svg,
  .line__extras-toggle svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .line__btn[data-action='remove'] {
    margin-right: auto;
  }

  .line__extras-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 44px;
    padding: 0 0.25rem;
    border: 0;
    background: transparent;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .line__extras-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .line__extras {
    display: grid;
    gap: 0.125rem;
    padding-left: 0.125rem;
  }

  /* Square boxes with a hand-drawn check, as on the cup label */
  .note__type {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    padding: var(--space-xs) 0 0;
    border: 0;
    border-top: 1px solid var(--ink);
  }

  .box {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    font-size: 0.9375rem;
    cursor: pointer;
  }

  .box--small {
    min-height: 40px;
    font-size: var(--text-small);
  }

  .box__mark {
    position: relative;
    display: inline-grid;
    flex: none;
  }

  .box__mark input {
    appearance: none;
    width: 20px;
    height: 20px;
    margin: 0;
    border: 1.75px solid var(--ink);
    border-radius: 2px;
    background: var(--label);
    cursor: pointer;
  }

  .box--small .box__mark input {
    width: 18px;
    height: 18px;
  }

  .box__check {
    position: absolute;
    left: -2px;
    top: -6px;
    width: 28px;
    height: 28px;
    fill: none;
    stroke: var(--brick);
    stroke-width: 2.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
    opacity: 0;
  }

  .box__mark input:checked + .box__check {
    opacity: 1;
  }

  .note__field {
    display: grid;
    gap: 0.25rem;
  }

  .note__field label {
    font-size: var(--text-small);
    font-weight: 600;
  }

  .note__field input,
  .note__field textarea,
  .note__fallback {
    width: 100%;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1.5px solid var(--ink-soft);
    border-radius: var(--radius-control);
    background: var(--label);
    font-size: 1rem;
  }

  .note__field textarea {
    resize: vertical;
  }

  .note__field .note__time {
    width: auto;
    min-width: 10rem;
  }

  .note__total {
    font-weight: 700;
    font-variation-settings: 'opsz' 18;
  }

  .note__actions {
    display: grid;
    justify-items: start;
    gap: var(--space-2xs);
  }

  .note__send,
  .note__copy.btn {
    width: 100%;
  }

  .note__copy--link {
    min-height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .note__copy--link[aria-disabled='true'] {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .note__copy--full {
    width: 100%;
    min-height: 48px;
    padding: 0.625rem 1.375rem;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius-control);
    text-decoration: none;
  }

  .note__small {
    color: var(--ink-soft);
    font-size: var(--text-small);
  }

  .note__small:empty {
    display: none;
  }

  .note__fallback {
    font-size: var(--text-small);
  }
</style>
