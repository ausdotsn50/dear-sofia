---
// Title, meta description, canonical, Open Graph, Twitter card and JSON-LD
// (SPEC §10). JSON-LD only includes details that are set in site.ts.
import { photo } from '../data/photos';
import { site } from '../data/site';
import { isTime, parseDays } from '../lib/hours';
import { allItems, menu } from '../lib/menu';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;

const path = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/?$/, '/');
const canonical = new URL(path, site.url).href;
const image = new URL('/og-default.jpg', site.url).href;
const imageAlt = photo('door-push-sign').alt;

const prices = allItems(menu)
  .map((item) => item.price)
  .filter((price): price is number => price !== null);
const priceRange = prices.length ? `₱${Math.min(...prices)}–₱${Math.max(...prices)}` : undefined;

const instagramUrl = site.instagramHandle ? `https://www.instagram.com/${site.instagramHandle}/` : null;
const sameAs = [site.facebookUrl, instagramUrl].filter((url): url is string => !!url);

const hours = (site.hours ?? [])
  .map((row) => {
    const dayOfWeek = parseDays(row.days);
    if (!dayOfWeek || !isTime(row.open) || !isTime(row.close)) return null;
    return { '@type': 'OpeningHoursSpecification', dayOfWeek, opens: row.open, closes: row.close };
  })
  .filter((row) => row !== null);

const { street, city } = site.address;
const jsonLd = noindex
  ? null
  : {
      '@context': 'https://schema.org',
      '@type': 'CafeOrCoffeeShop',
      name: site.name,
      url: new URL('/', site.url).href,
      image,
      servesCuisine: 'Coffee',
      hasMenu: new URL('/menu/', site.url).href,
      ...(priceRange && { priceRange }),
      ...((street || city) && {
        address: {
          '@type': 'PostalAddress',
          ...(street && { streetAddress: street }),
          ...(city && { addressLocality: city }),
        },
      }),
      ...(site.phone && { telephone: site.phone }),
      ...(hours.length > 0 && { openingHoursSpecification: hours }),
      ...(sameAs.length > 0 && { sameAs }),
    };
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_PH" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />

<link rel="sitemap" href="/sitemap-index.xml" />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
