---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource/patrick-hand/400.css';
import '../styles/tokens.css';
import '../styles/global.css';
import bricolageLatin from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';
import patrickHandLatin from '@fontsource/patrick-hand/files/patrick-hand-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import type { PageKind } from '../lib/nav';

interface Props {
  title: string;
  description?: string;
  page: PageKind;
  noindex?: boolean;
}

const { title, description, page, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preload" href={bricolageLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={patrickHandLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <SeoHead title={title} description={description} noindex={noindex} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer page={page} />
  </body>
</html>
